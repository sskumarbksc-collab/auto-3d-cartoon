    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["# Auto‑3D Cartoon Generator – Google Colab Notebook\n", "This notebook runs **Blender** (3‑D), **Coqui TTS** (Hindi voice), and **ffmpeg** to produce a 15‑20 min Hindi cartoon video. All heavy work is done in the free Colab environment; your local machine is not required.\n"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# 1️⃣ Mount Google Drive – where the final video will be saved\n",
                 "from google.colab import drive\n",
                 "drive.mount('/content/drive')\n"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# 2️⃣ Install required packages (Blender, Coqui TTS, ffmpeg)\n",
                 "!apt-get update -qq && apt-get install -y -qq blender ffmpeg\n",
                 "!pip install -q TTS numpy pandas tqdm\n"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# 3️⃣ Load your Hindi script\n",
                 "# You can either place the `script.json` file in your Drive folder `auto-3d-cartoon/`\n",
                 "# or edit the JSON string directly in the cell below.\n",
                 "import json, pathlib, os\n",
                 "script_path = pathlib.Path('/content/drive/MyDrive/auto-3d-cartoon/script.json')\n",
                 "if script_path.exists():\n",
                 "    script = json.load(open(script_path, 'r', encoding='utf-8'))\n",
                 "else:\n",
                 "    # Paste your script JSON here if not using Drive\n",
                 "    script_json = '''{\n  \"title\": \"Demo Cartoon\",\n  \"scenes\": [\n    {\n      \"character\": \"hero\",\n      \"line\": \"नमस्ते दोस्तों! यह हमारी पहली 3‑डी कहानी है।\",\n      \"duration\": 5\n    }\n  ]\n}'''\n",
                 "    script = json.loads(script_json)\n",
                 "\nprint('Loaded script with', len(script.get('scenes', [])), 'scenes')\n"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# 4️⃣ Generate Hindi audio with Coqui TTS (single track)\n",
                 "from TTS.api import TTS\n",
                 "import numpy as np, soundfile as sf\n",
                 "# Load a free Hindi model (tiny) – this may take a minute to download\n",
                 "tts = TTS(model_name='tts_models/hi/kazuma/tacotron2-DDC', progress_bar=False, gpu=False)\n",
                 "all_text = ' '.join([s['line'] for s in script['scenes']])\n",
                 "print('Generating audio for', len(all_text), 'characters...')\n",
                 "wav = tts.tts(text=all_text)\n",
                 "audio_path = '/content/drive/MyDrive/auto-3d-cartoon/audio.wav'\n",
                 "sf.write(audio_path, wav, samplerate=22050)\n",
                 "print('Audio saved to', audio_path)\n"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# 5️⃣ Prepare a minimal Blender scene and lip‑sync (very simple – cubes as characters)\n",
                 "# The script creates a stage, a camera, and a point‑light.\n",
                 "# Each scene's duration determines how many seconds the camera stays on that character.\n",
                 "import bpy, mathutils, os\n",
                 "# Clean default objects\n",
                 "bpy.ops.wm.read_factory_settings(use_empty=True)\n",
                 "# Create stage\n",
                 "bpy.ops.mesh.primitive_plane_add(size=20, location=(0,0,0))\n",
                 "stage = bpy.context.active_object\n",
                 "stage.name = 'Stage'\n",
                 "# Simple material\n",
                 "mat = bpy.data.materials.new(name='StageMat')\n",
                 "mat.diffuse_color = (0.8, 0.8, 0.8, 1)\n",
                 "stage.data.materials.append(mat)\n",
                 "# Camera\n",
                 "bpy.ops.object.camera_add(location=(0,-10,5), rotation=(math.radians(75),0,0))\n",
                 "camera = bpy.context.active_object\n",
                 "bpy.context.scene.camera = camera\n",
                 "# Light\n",
                 "bpy.ops.object.light_add(type='POINT', location=(0,0,6))\n",
                 "light = bpy.context.active_object\n",
                 "light.data.energy = 1500\n",
                 "# Simple character – a cube per scene\n",
                 "character_objs = []\n",
                 "current_frame = 1\n",
                 "fps = 24\n",
                 "bpy.context.scene.render.fps = fps\n",
                 "for idx, sc in enumerate(script['scenes']):\n",
                 "    bpy.ops.mesh.primitive_cube_add(size=1, location=(0,0,1))\n",
                 "    char = bpy.context.active_object\n",
                 "    char.name = f'Char_{idx}'\n",
                 "    # Color by character name (simple hash)\n",
                 "    matc = bpy.data.materials.new(name=f'Mat_{idx}')\n",
                 "    hue = (hash(sc['character']) % 100) / 100.0\n",
                 "    matc.diffuse_color = (hue, 0.5, 0.8, 1)\n",
                 "    char.data.materials.append(matc)\n",
                 "    # Keyframe visibility – show only current character\n",
                 "    char.hide_viewport = True\n",
                 "    char.keyframe_insert(data_path='hide_viewport', frame=current_frame)\n",
                 "    char.hide_viewport = False\n",
                 "    char.keyframe_insert(data_path='hide_viewport', frame=current_frame+1)\n",
                 "    # Hide after its duration\n",
                 "    end_f = current_frame + int(sc['duration']*fps)\n",
                 "    char.hide_viewport = True\n",
                 "    char.keyframe_insert(data_path='hide_viewport', frame=end_f)\n",
                 "    current_frame = end_f + fps  # a short pause before next scene\n",
                 "    character_objs.append(char)\n",
                 "# Set end frame\n",
                 "bpy.context.scene.frame_end = current_frame\n",
                 "# Write Blender file for debugging (optional)\n",
                 "blend_path = '/content/drive/MyDrive/auto-3d-cartoon/scene.blend'\n",
                 "bpy.ops.wm.save_as_mainfile(filepath=blend_path)\n",
                 "print('Blender scene saved to', blend_path)\n"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# 6️⃣ Render animation to MP4\n",
                 "output_path = '/content/drive/MyDrive/auto-3d-cartoon/output.mp4'\n",
                 "bpy.context.scene.render.image_settings.file_format = 'FFMPEG'\n",
                 "bpy.context.scene.render.ffmpeg.format = 'MPEG4'\n",
                 "bpy.context.scene.render.ffmpeg.codec = 'H264'\n",
                 "bpy.context.scene.render.ffmpeg.audio_codec = 'AAC'\n",
                 "bpy.context.scene.render.filepath = output_path\n",
                 "print('Starting render – this may take 10‑20 minutes depending on length...')\n",
                 "bpy.ops.render.render(animation=True)\n",
                 "print('Render complete – video saved to', output_path)\n"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# 7️⃣ Create a simple status JSON so the dashboard can show progress\n",
                 "import json, time\n",
                 "status = {\n",
                 "    'title': script.get('title', 'Auto‑3D Cartoon'),\n                 "    'progress': 'completed',\n                 "    'video_url': f'https://drive.google.com/uc?id=' + os.path.basename(output_path),\n                 "    'timestamp': time.time()\n",
                 "}\n",
                 "status_path = '/content/drive/MyDrive/auto-3d-cartoon/status.json'\n",
                 "with open(status_path, 'w', encoding='utf-8') as f:\n",
                 "    json.dump(status, f, ensure_ascii=False, indent=2)\n",
                 "print('Status written to', status_path)\n"]
    }
  ],
